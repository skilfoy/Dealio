# ============================================
# DealRadar Environment Configuration
# Copy to .env and customize values
# ============================================

# --- Database ---
POSTGRES_USER=dealradar
POSTGRES_PASSWORD=dealradar_dev
POSTGRES_DB=dealradar
DATABASE_URL=postgresql+asyncpg://dealradar:dealradar_dev@postgres:5432/dealradar

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
SECRET_KEY=change-me-to-a-random-string

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================
# Optional API Keys (app works without these)
# Add keys to unlock additional data sources
# ============================================

# --- Retailer APIs ---
# BESTBUY_API_KEY=          # Free at developer.bestbuy.com — unlocks full Best Buy catalog
# KEEPA_API_KEY=            # keepa.com — Amazon price history (crown jewel)
# RAINFOREST_API_KEY=       # rainforestapi.com — Amazon product data
# BLUECART_API_KEY=         # bluecartapi.com — Walmart product data
# ZINC_API_KEY=             # zincapi.com — Amazon ordering API

# --- Proxy/Scraping Services ---
# BRIGHTDATA_API_KEY=       # brightdata.com — residential proxies
# SCRAPERAPI_KEY=           # scraperapi.com — web scraping proxy
# ZENROWS_API_KEY=          # zenrows.com — anti-bot bypass

# --- Notifications ---
# DISCORD_WEBHOOK_URL=      # Discord channel webhook for deal alerts
# SLACK_WEBHOOK_URL=        # Slack channel webhook for deal alerts
# TELEGRAM_BOT_TOKEN=       # Telegram bot token
# TELEGRAM_CHAT_ID=         # Telegram chat/channel ID
# PUSHOVER_USER_KEY=        # pushover.net user key
# PUSHOVER_API_TOKEN=       # pushover.net app token
# SENDGRID_API_KEY=         # sendgrid.com — email notifications
# TWILIO_ACCOUNT_SID=       # twilio.com — SMS notifications
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# NOTIFICATION_PHONE=       # Your phone number for SMS alerts
# NOTIFICATION_EMAIL=       # Your email for email alerts
